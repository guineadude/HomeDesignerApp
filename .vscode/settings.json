{
    "cmake.enableAutomaticKitScan": false,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    "clangd.fallbackFlags": [
        "-std=c++23",
        "-I${workspaceFolder}/src",
        "-I${workspaceFolder}/build/_deps/sdl3-src/include",
        "-I${workspaceFolder}/build/_deps/sdl3_image-src/include",
        "-I${workspaceFolder}/build/_deps/sdl3_ttf-src/include"
    ],
    "[cpp]": {
        "editor.foldingStrategy": "auto",
        "editor.defaultFoldingRangeProvider": "zokugun.explicit-folding",
        "explicitFolding.rules": [
    {
        "begin": "{",
        "end": "}",
        "nested": true,
        "foldBeforeFirstLine": true,
        "foldLastLine": true
    }
]
    }
}